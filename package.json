{
  "name": "@proctorio/observe",
  "version": "1.0.0",
  "description": "JavaScript SDK for subscribing to Proctorio exam monitoring events and implementing custom logic for online exam security.",
  "main": "./lib/index.cjs.js",
  "module": "./lib/index.esm.js",
  "browser": "./lib/index.min.js",
  "jsdelivr": "./lib/index.min.js",
  "exports": {
    ".": {
      "import": "./lib/index.esm.js",
      "require": "./lib/index.cjs.js",
      "browser": "./lib/index.min.js"
    }
  },
  "files": [
    "lib/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proctorio/observe.js.git"
  },
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "rollup -c",
    "clean": "rm -rf lib coverage",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "dev": "npm run build -- --watch"
  },
  "keywords": [
    "proctorio",
    "exam",
    "monitoring",
    "security",
    "sdk",
    "events",
    "browser-extension",
    "online-testing"
  ],
  "author": "Proctorio",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/proctorio/observe.js/issues"
  },
  "homepage": "https://github.com/proctorio/observe.js#readme",
  "sideEffects": true,
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@rollup/plugin-terser": "0.4.4",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "rollup": "^4.40.0"
  },
  "jest": {
    "testEnvironment": "jsdom"
  }
}
